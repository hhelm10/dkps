\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Adaptive probes (per-target CAT panels). The blend is best-or-tied everywhere; the trace increment is significant at $m\le 3$ and vanishes as correctness information saturates ($m\ge 10$).\relax }}{2}{}\protected@file@percent }
\newlabel{tab:adaptive}{{2}{2}}
