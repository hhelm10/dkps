\relax 
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Qubric has the sensitivity profile efficient evaluation requires, across seven embedders (rim = ideal). Raw embeddings (navy) are confounder-dominated; qubric (amber) collapses Identity / Model family / Harness to chance while holding Task and Behavior.\relax }}{2}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:radar}{{1}{2}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Requirements by representation: each cell is the raw metric for that axis under that representation; blue = ideal for evaluation. Qubric is the only row simultaneously content-faithful and confounder-invariant.\relax }}{2}{}\protected@file@percent }
\newlabel{fig:heatmap}{{2}{2}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Random probes (B=20 draws): MAE predicting the true resolve rate. The blend beats the best correctness-only method at every budget; all paired deltas exclude zero.\relax }}{2}{}\protected@file@percent }
