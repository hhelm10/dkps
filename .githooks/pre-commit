#!/bin/bash
# Rebuild trubric.pdf whenever paper sources are part of the commit.
W=projects/trubric/writing
if git diff --cached --name-only | grep -qE "^($W/(trubric\.tex|references\.bib|.*\.sty|.*\.bst)|projects/trubric/artifacts/)"; then
    echo "[pre-commit] syncing figures/ + rebuilding $W/trubric.pdf"
    cp projects/trubric/artifacts/trubric_figure*.pdf \
       projects/trubric/artifacts/trubric_*.tex $W/figures/
    git add $W/figures
    ( cd $W \
      && pdflatex -interaction=nonstopmode trubric.tex > /dev/null \
      && bibtex trubric > /dev/null 2>&1 \
      && pdflatex -interaction=nonstopmode trubric.tex > /dev/null \
      && pdflatex -interaction=nonstopmode trubric.tex > /dev/null ) \
    || { echo "[pre-commit] LaTeX build FAILED (see $W/trubric.log)"; exit 1; }
    git add $W/trubric.pdf
fi
