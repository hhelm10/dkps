\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Ablations under leave-one-family-out evaluation on SWE-bench Verified. (a) Effect of the number of reference systems $n$ for $m \in \{1, 5, 20\}$ tasks (line weight). (b) Random (open) vs.\ adaptive (filled) task selection for \textsc  {trubric}{} geometry with $n = 107$ (solid) and $n = 20$ (dashed) reference systems. (c) Effect of the text encoder on \textsc  {trubric}{} geometry.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:ablations}{{4}{5}{Ablations under leave-one-family-out evaluation on SWE-bench Verified. (a) Effect of the number of reference systems $n$ for $m \in \{1, 5, 20\}$ tasks (line weight). (b) Random (open) vs.\ adaptive (filled) task selection for \trubric {} geometry with $n = 107$ (solid) and $n = 20$ (dashed) reference systems. (c) Effect of the text encoder on \trubric {} geometry}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Evaluation cost per target system (at a nominal \$2 per execution) to reach a given MAE (left two panels) and a given pairwise ranking accuracy on system pairs separated by at least 0.05 (right two panels). The star marks full-benchmark evaluation: exact scores at full cost.}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:cost}{{5}{5}{Evaluation cost per target system (at a nominal \$2 per execution) to reach a given MAE (left two panels) and a given pairwise ranking accuracy on system pairs separated by at least 0.05 (right two panels). The star marks full-benchmark evaluation: exact scores at full cost}{figure.5}{}}
