\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean Absolute Error (MAE) of benchmark score estimators for SWE-bench Verified and Terminal-Bench 2.0 under leave-one-family-out evaluation and different task selection protocols (random \& adaptive). \textbf  {Bolded} values are the best method for a given benchmark, task selection, and number of tasks. \underline  {Underlined} values are statistically significant ($\alpha = 0.05$) comparisons to IRT per the two-sided Wilcoxon signed-rank test. The \textsc  {trubric}{} and IRT blend -- which takes advantage of both trace geometry and per-execution score -- is the best or near-best in all settings.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:hero}{{1}{2}{Mean Absolute Error (MAE) of benchmark score estimators for SWE-bench Verified and Terminal-Bench 2.0 under leave-one-family-out evaluation and different task selection protocols (random \& adaptive). \textbf {Bolded} values are the best method for a given benchmark, task selection, and number of tasks. \underline {Underlined} values are statistically significant ($\alpha = 0.05$) comparisons to IRT per the two-sided Wilcoxon signed-rank test. The \trubric {} and IRT blend -- which takes advantage of both trace geometry and per-execution score -- is the best or near-best in all settings}{table.1}{}}
