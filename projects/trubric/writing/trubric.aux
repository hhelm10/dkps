\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Held-out balanced accuracy of linear probes for five trace attributes, chance-normalized so that chance sits at the center and better-for-evaluation is outside: content attributes (Correctness, Task) plot recoverability and system-metadata attributes (Harness, Model Family, System Identity) plot its complement. One panel per text encoder; raw traces vs.\ generic-rubric vs.\ \textsc  {trubric}{} summaries.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:radar}{{1}{3}{Held-out balanced accuracy of linear probes for five trace attributes, chance-normalized so that chance sits at the center and better-for-evaluation is outside: content attributes (Correctness, Task) plot recoverability and system-metadata attributes (Harness, Model Family, System Identity) plot its complement. One panel per text encoder; raw traces vs.\ generic-rubric vs.\ \trubric {} summaries}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Two-dimensional PKPS representations of 107 SWE-bench Verified systems, colored by benchmark score (gold high, blue low), for raw-trace embeddings (top) and \textsc  {trubric}{} embeddings (bottom) as the number of reference systems $n$ and tasks $m$ grows. Panels within a row are Procrustes-aligned; badges report leave-one-system-out MAE of a $k$NN predictor in each panel.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:pkps}{{2}{3}{Two-dimensional PKPS representations of 107 SWE-bench Verified systems, colored by benchmark score (gold high, blue low), for raw-trace embeddings (top) and \trubric {} embeddings (bottom) as the number of reference systems $n$ and tasks $m$ grows. Panels within a row are Procrustes-aligned; badges report leave-one-system-out MAE of a $k$NN predictor in each panel}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces MAE of benchmark-score estimators as a function of the task budget $m$ (random task selection, $B=50$ shared draws, $\pm 1$ SEM bands) on SWE-bench Verified (top) and Terminal-Bench 2.0 (bottom) under three reference-exclusion protocols of increasing conservatism.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:protocols}{{3}{4}{MAE of benchmark-score estimators as a function of the task budget $m$ (random task selection, $B=50$ shared draws, $\pm 1$ SEM bands) on SWE-bench Verified (top) and Terminal-Bench 2.0 (bottom) under three reference-exclusion protocols of increasing conservatism}{figure.3}{}}
