\@writefile{toc}{\contentsline {paragraph}{Rubric-based preprocessing produces more useful trace representations.}{3}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparisons of the properties of three different methods for embedding executed task traces across seven different off-the-shelf text encoders: embedding the raw trace, embedding a structured summary based on a generic rubric, and embedding a structured summary based on a task-specific rubric. As measured by the balanced accuracy of held-out linear probes, described in Section\nobreakspace  {}\ref  {sec:method}, the embedding of the task-specific summary is better at removing undesirable signal while preserving relevant signal across all seven encoders.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:radar}{{1}{4}{Comparisons of the properties of three different methods for embedding executed task traces across seven different off-the-shelf text encoders: embedding the raw trace, embedding a structured summary based on a generic rubric, and embedding a structured summary based on a task-specific rubric. As measured by the balanced accuracy of held-out linear probes, described in Section~\ref {sec:method}, the embedding of the task-specific summary is better at removing undesirable signal while preserving relevant signal across all seven encoders}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The 2-d Product Kernel Perspective Space (PKPS) induced with raw trace embeddings (top) and the \textsc  {trubric}{} embeddings (bottom) under different number of reference systems and number of task executions. Each dot is a system colored by full benchmark score on SWE-bench Verified. The manifold of systems under the \textsc  {trubric}{} embeddings is more strongly correlated with the full benchmark score in paired settings. We report the average Mean Absolute Error (MAE) under leave-one-system-out (LOSO) protocol to quantify this observation.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:pkps}{{2}{4}{The 2-d Product Kernel Perspective Space (PKPS) induced with raw trace embeddings (top) and the \trubric {} embeddings (bottom) under different number of reference systems and number of task executions. Each dot is a system colored by full benchmark score on SWE-bench Verified. The manifold of systems under the \trubric {} embeddings is more strongly correlated with the full benchmark score in paired settings. We report the average Mean Absolute Error (MAE) under leave-one-system-out (LOSO) protocol to quantify this observation}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The Mean Absolute Error (MAE) of benchmark score estimators as a function of the number of executed tasks for SWE-bench Verified (top) and Terminal-Bench 2.0 (bottom) under three different realistic evaluation protocols: leave-one-system-out (left), leave-one-family-out (center), and leave-one-harness-out (right). Reported MAE is the average over 50 random subsets of tasks. Shaded areas represent $ \pm 1 $ S.E. The \textsc  {trubric}{} and IRT blend dominates all methods (i.e., is never worse and is sometimes better) across all protocols, datasets, and number of executed tasks.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:protocols}{{3}{5}{The Mean Absolute Error (MAE) of benchmark score estimators as a function of the number of executed tasks for SWE-bench Verified (top) and Terminal-Bench 2.0 (bottom) under three different realistic evaluation protocols: leave-one-system-out (left), leave-one-family-out (center), and leave-one-harness-out (right). Reported MAE is the average over 50 random subsets of tasks. Shaded areas represent $ \pm 1 $ S.E. The \trubric {} and IRT blend dominates all methods (i.e., is never worse and is sometimes better) across all protocols, datasets, and number of executed tasks}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Trace geometry alone supports task-efficient benchmark prediction.}{5}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Combining trace geometry with correctness outcomes improves prediction beyond either source alone.}{5}{section*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mean Absolute Error (MAE) of benchmark score estimators with access to different number of reference systems (left), different task selection procedures (center), and using different text encoders (right) under the leave-one-family-out evaluation protocol. Reported MAE is the average over 50 random subsets of tasks; adaptive task paths are deterministic given the reference systems. Adaptive tasks are selected sequentially to maximize Fisher information under a two-parameter logistic model fit to the reference systems, as described in Section\nobreakspace  {}\ref  {sec:method}.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:ablations}{{4}{6}{Mean Absolute Error (MAE) of benchmark score estimators with access to different number of reference systems (left), different task selection procedures (center), and using different text encoders (right) under the leave-one-family-out evaluation protocol. Reported MAE is the average over 50 random subsets of tasks; adaptive task paths are deterministic given the reference systems. Adaptive tasks are selected sequentially to maximize Fisher information under a two-parameter logistic model fit to the reference systems, as described in Section~\ref {sec:method}}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The cost of achieving a particular Mean Absolute Error (MAE; left and center left) and pairwise ranking error (center right and right) when using different benchmark score estimators on SWE-bench Verified and Terminal-Bench 2.0. Stars indicate the cost of producing the true benchmark score. An ideal method has low error (to the left) and is cheap (lower). Costs are calculated at a nominal \$2 per task execution. Values are estimated using the leave-one-family-out results underlying Table\nobreakspace  {}\ref  {tab:hero} and, for pairwise error, leave-two-out comparisons of system pairs whose true scores differ by at least 0.05.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:cost}{{5}{6}{The cost of achieving a particular Mean Absolute Error (MAE; left and center left) and pairwise ranking error (center right and right) when using different benchmark score estimators on SWE-bench Verified and Terminal-Bench 2.0. Stars indicate the cost of producing the true benchmark score. An ideal method has low error (to the left) and is cheap (lower). Costs are calculated at a nominal \$2 per task execution. Values are estimated using the leave-one-family-out results underlying Table~\ref {tab:hero} and, for pairwise error, leave-two-out comparisons of system pairs whose true scores differ by at least 0.05}{figure.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Trace-informed estimation reduces the cost of reaching a given prediction accuracy.}{6}{section*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The effect of the number of fields present in the rubric used to extract a structured summary of the trace on Mean Absolute Error (MAE) for different number of executed tasks and different number of reference systems for both task-specific and generic rubrics. We report both the MAE for the average (bold) and best performing (thin) sets of fields. In general, a task-specific rubric is preferred to a generic rubric when there are fewer reference systems and more executed tasks available.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:sensitivity}{{6}{7}{The effect of the number of fields present in the rubric used to extract a structured summary of the trace on Mean Absolute Error (MAE) for different number of executed tasks and different number of reference systems for both task-specific and generic rubrics. We report both the MAE for the average (bold) and best performing (thin) sets of fields. In general, a task-specific rubric is preferred to a generic rubric when there are fewer reference systems and more executed tasks available}{figure.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Performance improves with larger reference libraries and adaptive task selection.}{7}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Broader rubrics improve average performance, though strong, small rubrics may exist.}{7}{section*.6}\protected@file@percent }
